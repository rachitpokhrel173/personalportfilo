# Public URL of the deployed site (canonical URLs, sitemap, Open Graph, resume links).
NEXT_PUBLIC_SITE_URL=https://rachitpokhrel.com.np

# Contact form email delivery via Resend (https://resend.com). Without a key the form
# still validates input but tells visitors to email directly; it never pretends to send.
RESEND_API_KEY=
# Optional. Defaults: from "Portfolio <onboarding@resend.dev>", to SITE.contactTo in src/lib/site.ts.
CONTACT_FROM=
CONTACT_TO=
